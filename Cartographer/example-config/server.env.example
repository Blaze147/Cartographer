# Example server configuration. Copy to .env or export in your shell.
# Port the server listens on.
ASPNETCORE_URLS=http://+:5080
# Path to the JSON persistence file.
CARTOGRAPHER_DATA=data.json
# Optional shared secret. If non-empty, agents must send it as X-Api-Key.
CARTOGRAPHER_API_KEY=
# Optional password for the browser dashboard. If non-empty, the UI prompts for it.
CARTOGRAPHER_WEB_PASSWORD=
# Seconds without a heartbeat before a machine is considered offline.
CARTOGRAPHER_OFFLINE_SECONDS=90
